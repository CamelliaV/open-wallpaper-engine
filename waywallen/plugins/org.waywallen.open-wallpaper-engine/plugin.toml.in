# Wallpaper Engine — scene (.pkg) renderer + Steam Workshop subscription source,
# plus the CEF web renderer when built with -DBUILD_WEWEB=ON.
#
# GENERATED by CMake (configure_file) — edit plugin.toml.in / the CMake
# rules, not the installed copy. Every plugin must ship a sibling
# `files.txt` (one path per line); this one is produced by CMake.
#
# The Lua entry advertises scene/video/web source and subscription capabilities;
# video routes to the image/video plugin's renderer purely by wallpaper type.

[plugin]
id = "@OWE_WAYWALLEN_PLUGIN_ID@"
name = "Wallpaper Engine"
version = "@OWE_PLUGIN_VERSION@"
update = "@OWE_WAYWALLEN_PLUGIN_UPDATE_URL@"
entry = "main.lua"
entry_version = 3

[renderers.wescene-renderer]
bin = "@OWE_WESCENE_BIN@"
types = ["scene"]
priority = 100
spawn_version = 8
extras = ["assets", "workshop_id"]

[renderers.wescene-renderer.settings]
enable_audio = { type = "bool", default = true, identity = false, label_key = "settings.wescene.enable_audio", group = "audio", order = 5 }
volume = { type = "u32", default = 100, min = 0, max = 100, step = 1, identity = false, label_key = "settings.wescene.volume", group = "audio", order = 10 }
fps    = { type = "u32", default = 30,  min = 1, max = 240, step = 1, identity = false, label_key = "settings.wescene.fps", group = "render", order = 20 }
hwdec = { type = "string", default = "auto", choices = ["auto", "vaapi", "vulkan", "none"], identity = true, label_key = "settings.wescene.hwdec", group = "decode", order = 20 }
render_node = { type = "string", default = "", identity = true, label_key = "settings.wescene.render_node", group = "render", order = 30 }
msaa   = { type = "u32", default = 1, min = 1, max = 16, step = 1, identity = true, label_key = "settings.wescene.msaa", group = "render", order = 25 }
# -1 = custom, 1 = 720p, 2 = 1080p, 3 = 1440p, 4 = 2160p. Origin is disallowed for scene.
resolution = { type = "i32", default = 2, min = -1, max = 4, step = 1, identity = true, label_key = "settings.wescene.resolution", group = "render", order = 22 }
custom_extent = { type = "u32", default = 1080, min = 1, max = 8192, step = 1, identity = true, label_key = "settings.wescene.custom_extent", group = "render", order = 23 }
@OWE_WEWEB_BLOCK@
