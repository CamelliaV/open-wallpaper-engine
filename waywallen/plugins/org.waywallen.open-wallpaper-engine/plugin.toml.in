# Wallpaper Engine — scene (.pkg) renderer + Steam-workshop source,
# plus the CEF web renderer when built with -DBUILD_WEWEB=ON.
#
# GENERATED by CMake (configure_file) — edit plugin.toml.in / the CMake
# rules, not the installed copy. Every plugin must ship a sibling
# `files.txt` (one path per line); this one is produced at install time.
#
# The source component advertises scene/video/web wp_types; video routes
# to the image/video plugin's renderer purely by wallpaper type.

[plugin]
id = "org.waywallen.open-wallpaper-engine"
name = "Wallpaper Engine"
version = "@OWE_PLUGIN_VERSION@"

[source]
lua = "wallpaper_engine.lua"

[renderers.wescene-renderer]
bin = "bin/waywallen-wescene-renderer"
types = ["scene"]
priority = 100
spawn_version = 5
extras = ["assets", "workshop_id"]
events = ["pointer"]

[renderers.wescene-renderer.settings]
enable_audio = { type = "bool", default = true, identity = true, label_key = "settings.wescene.enable_audio", group = "audio", order = 5 }
volume = { type = "u32", default = 100, min = 0, max = 100, step = 1, identity = false, label_key = "settings.wescene.volume", group = "audio", order = 10 }
fps    = { type = "u32", default = 30,  min = 1, max = 240, step = 1, identity = false, label_key = "settings.wescene.fps", group = "render", order = 20 }
render_node = { type = "string", default = "", identity = true, label_key = "settings.wescene.render_node", group = "render", order = 30 }
msaa   = { type = "u32", default = 1, min = 1, max = 16, step = 1, identity = true, label_key = "settings.wescene.msaa", group = "render", order = 25 }
# 1 = 720p, 2 = 1080p, 3 = 1440p, 4 = 2160p — no origin for scene (no native size); drives the actual render extent at a 16:9 base aspect.
resolution = { type = "u32", default = 2, min = 1, max = 4, step = 1, identity = true, label_key = "settings.wescene.resolution", group = "render", order = 22 }
@OWE_WEWEB_BLOCK@