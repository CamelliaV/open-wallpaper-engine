
# CEF (Wallpaper Engine *web*) renderer. web wp_type entries come from the
# Lua entry above.
[renderers.weweb-renderer]
bin = "@OWE_WEWEB_BIN@"
types = ["web"]
priority = 100
spawn_version = 8
extras = ["workshop_id"]
events = ["pointer"]

[renderers.weweb-renderer.settings]
enable_audio = { type = "bool", default = true, identity = true, label_key = "settings.weweb.enable_audio", group = "audio", order = 5 }
volume = { type = "u32", default = 100, min = 0, max = 100, step = 1, identity = false, label_key = "settings.weweb.volume", group = "audio", order = 10 }
# Hot-reloadable via SetWindowlessFrameRate on the live browser.
fps = { type = "u32", default = 30, min = 1, max = 240, step = 1, identity = false, label_key = "settings.weweb.fps", group = "render", order = 20 }
# 1 = 720p, 2 = 1080p, 3 = 1440p, 4 = 2160p. Origin/custom are disallowed for web.
resolution = { type = "i32", default = 2, min = 1, max = 4, step = 1, identity = true, label_key = "settings.weweb.resolution", group = "render", order = 25 }
shared_texture_enabled = { type = "bool", default = true, identity = true, label_key = "settings.weweb.shared_texture_enabled", group = "render", order = 30 }
render_node = { type = "string", default = "", identity = true, label_key = "settings.weweb.render_node", group = "render", order = 35 }
# CEF can only honour --remote-debugging-port at CefInitialize time;
# changing it requires a respawn — identity = true.
remote_debugging_port = { type = "u32", default = 0, min = 0, max = 65535, identity = true, label_key = "settings.weweb.remote_debugging_port", group = "debug", order = 40 }
